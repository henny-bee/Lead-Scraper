APP_ENV=prod
HOST=0.0.0.0
PORT=8000

# Job lifecycle
JOB_TTL_MINUTES=15
JOB_FAILED_TTL_MINUTES=30
TEMP_DIR=/tmp/leadscraper

# Resolver
NOMINATIM_URL=
NOMINATIM_MAX_RPS=1
INDUSTRY_EMBEDDINGS_ENABLED=false
INDUSTRY_LLM_ENABLED=false

# Sources
OVERPASS_URL=https://overpass-api.de/api/interpreter
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ENABLED=false
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_ENABLED=false

# Crawler
CRAWLER_USER_AGENT="LeadScraperBot/0.3 (+https://your-domain.de/bot)"
CRAWLER_GLOBAL_CONCURRENCY=16
CRAWLER_PER_DOMAIN_DELAY_S=2
CRAWLER_MAX_PAGES_PER_DOMAIN=5
CRAWLER_MAX_RESPONSE_MB=2

# Verification
SMTP_VERIFY_ENABLED=false
SMTP_HELO_HOST=
SMTP_MAIL_FROM=

# Optional security
API_KEY=
